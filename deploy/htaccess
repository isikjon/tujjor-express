# Tujjor Express Chirchiq — static Next.js export on Apache / LiteSpeed shared hosting.
# Upload the contents of the zip into the site root (public_html / www / htdocs).
# Pages live in folders (services/index.html); only /api/track/* needs mod_rewrite.

AddDefaultCharset utf-8
<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>
# no directory listings (a directory without index.html answers 403/404 either way)
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

# ---- MIME types (3D assets, decoders, fonts, manifest) --------------------------------------
<IfModule mod_mime.c>
  AddType application/wasm            .wasm
  AddType model/gltf-binary           .glb
  AddType model/gltf+json             .gltf
  AddType image/ktx2                  .ktx2
  AddType font/woff2                  .woff2
  AddType font/woff                   .woff
  AddType application/manifest+json   .webmanifest
  AddType application/json            .json
  AddType image/svg+xml               .svg
  AddType image/avif                  .avif
  AddType image/webp                  .webp
  # the Open Graph image is exported without an extension
  <Files "opengraph-image">
    ForceType image/png
  </Files>
</IfModule>

# ---- Routing --------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Tracking API: /api/track/CODE  →  api/track.php?code=CODE
  RewriteRule ^api/track/([A-Za-z0-9-]{1,40})/?$ api/track.php?code=$1 [L,QSA,NC]

  # Pages are exported as folders (services/index.html) — served natively; /services → /services/
  # is the ordinary directory redirect. Unknown paths fall through to ErrorDocument 404.
</IfModule>

ErrorDocument 404 /404.html

# Deployment notes are not a web page
<Files "README-HOSTING.txt">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</Files>

# ---- Force HTTPS (uncomment after SSL is enabled on the hosting) ----------------------------
